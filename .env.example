# ==============================================================================
# Voyage-AI — Environment Variable Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' for local development:
#    cp .env.example .env (or in PowerShell: Copy-Item .env.example .env)
# 2. Never commit '.env' to version control.
# ==============================================================================

# Database Configuration (MySQL)
# Default targets local host MySQL on port 3306 (user 'root', database 'voyage').
# Note: If running via Docker Compose instead of local host MySQL, set MYSQL_PORT=3307 and credentials accordingly.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=voyage
MYSQL_USER=root
MYSQL_PASSWORD=

# Docker Compose Specific MySQL Variables (only used when running infra/docker-compose.yml)
DOCKER_MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=voyage_root_password

# Spring Boot Backend Configuration
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# CORS Configuration (Allowed Origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication Placeholder (Future Implementation)
# NOTE: In production, generate a secure random 256-bit+ base64 key.
JWT_SECRET=voyageai_dev_secret_key_placeholder_not_for_production_min_256_bits_required!
JWT_EXPIRATION_MS=86400000

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8081/api/v1

# ==============================================================================
# External Travel & Data Providers (Data Authenticity & Provenance Architecture)
# All integrations default to zero-cost, open, or free-tier APIs.
# Credentials must NEVER be committed or leaked to client code.
# ==============================================================================

# OpenTripMap API (Attractions, Heritage Sites, Historical POIs)
# Free Tier: 1,000 requests/day. Register at: https://opentripmap.io/product
# When empty, system serves verified seed records only without external lookup.
OPENTRIPMAP_API_KEY=

# Open-Meteo API (Live Weather & Historical Climate)
# 100% Free for open use up to 10,000 calls/day. No API key required.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Open Source Routing Machine (OSRM) (Transit Distances & Drive Times)
# Public demo endpoint or local container. No API key required.
OSRM_ROUTING_BASE_URL=https://router.project-osrm.org

# Wikimedia Commons API (Verified Monument & POI Media)
# Free open access. A descriptive User-Agent is required by Wikimedia policy.
WIKIMEDIA_USER_AGENT=VoyageAI-SubcontinentTravelApp/1.0 (contact@voyageai.local)

# Unsplash Developer API (High-Resolution Curated Imagery)
# Free Tier: 50 req/hr (Demo), 5,000 req/hr (Production upon free approval).
# Register at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Google Gemini API Key & Model (Google AI Studio Developer API)
# Free Tier: 15 RPM / 1,500 RPD. Register at: https://aistudio.google.com/
# Leave blank in version control; set in local .env or system environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
